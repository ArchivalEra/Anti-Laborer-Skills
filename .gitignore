# ==============================================================================
# 严格白名单模式 (Strict Whitelist Configuration)
# 默认忽略一切文件，只有显式在此处添加绝对路径的文件才会被 git 跟踪与推送。
# 注意事项：
# 1. 白名单项必须以 "!/" 开头（绝对定位至仓库根目录）。
# 2. 禁止使用广义通配符（如 *.md、*.py 等），必须是具体文件的绝对路径。
# ==============================================================================

# 1. 默认忽略所有文件
*

# 2. 允许遍历目录树（Git 必须穿透目录结构以定位白名单文件）
!*/

# 3. 基础工程白名单（必须为绝对路径）
!/.gitignore
!/.githooks/pre-commit
!/README.md
!/README.en.md

# 4. 采集工具与多平台矩阵解析引擎白名单
!/scripts/harvest.mjs
!/scripts/harvester/index.mjs
!/scripts/harvester/utils.mjs
!/scripts/harvester/router.mjs
!/scripts/harvester/platforms/generic.mjs
!/scripts/harvester/platforms/domestic/short_video.mjs
!/scripts/harvester/platforms/domestic/knowledge_forum.mjs
!/scripts/harvester/platforms/domestic/social_media.mjs
!/scripts/harvester/platforms/international/social_video.mjs
!/scripts/harvester/platforms/international/messaging_newsletters.mjs

# 5. skills/source-evaluator 绝对路径白名单
!/skills/source-evaluator/SKILL.md
!/skills/source-evaluator/SKILL.en.md
!/skills/source-evaluator/RUBRIC.md
!/skills/source-evaluator/RUBRIC.en.md
!/skills/source-evaluator/scripts/filter.py

# 6. skills/anti-anthropoid-lifecycle 绝对路径白名单
!/skills/anti-anthropoid-lifecycle/SKILL.md
!/skills/anti-anthropoid-lifecycle/SKILL.en.md
!/skills/anti-anthropoid-lifecycle/TAXONOMY.md
!/skills/anti-anthropoid-lifecycle/TAXONOMY.en.md
!/skills/anti-anthropoid-lifecycle/scripts/deconstruct.py
